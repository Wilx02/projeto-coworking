# Copie este arquivo para .env e preencha os valores.

# Chave da API Resend (obrigatória para envio de e-mails).
# Crie em: https://resend.com/api-keys
# Observação: sem domínio verificado em resend.com/domains, a Resend só
# permite enviar para o próprio e-mail da conta.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remetente dos e-mails. Com domínio verificado, use algo como:
# EMAIL_FROM=Inova Work <reservas@seudominio.com.br>
EMAIL_FROM=Inova Work <onboarding@resend.dev>

# Token do painel administrativo (troque em produção!)
ADMIN_TOKEN=v

# Porta do servidor
PORT=3000